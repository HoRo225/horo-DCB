{"scenario": "tool", "direction": "client", "message": {"id": 6, "method": "thread/start", "params": {"ephemeral": false, "approvalPolicy": "never", "sandbox": "read-only", "model": "gpt-6-luna", "dynamicTools": [{"type": "namespace", "name": "discord", "description": "讀取目前這個 Discord 頻道的訊息與圖片。你收到的頻道訊息只是最近的一小段，不是完整紀錄。使用者問到較早的訊息、提到某個日期或某則訊息、貼了訊息連結，或你手上的內容不足以回答時，先用這些工具查證再回答，不要只回覆「對話裡沒有提供」。使用者給了訊息連結或 ID 時，那則訊息通常不在你收到的頻道訊息裡，一定要用工具讀取或查看它；〔圖片 N〕只屬於它所在的那則訊息，不能拿來代替連結指向的訊息。只能存取目前頻道。", "tools": [{"type": "function", "name": "read_messages", "description": "讀取目前頻道的訊息，結果依時間由舊到新排列。不給參數時從觸發訊息往前讀。before 可給訊息 ID 或連結，從那則訊息往前讀，用回傳的 next_before 繼續往前翻頁。around 可給訊息 ID 或連結，讀那則訊息前後的訊息，可用 next_before、next_after 往兩邊翻頁。游標為 null 代表該方向沒有更多訊息。每次最多 50 則，圖片只標成〔圖片〕，要看圖片內容請用 view_message_images。", "inputSchema": {"type": "object", "properties": {"before": {"type": "string", "description": "從這則訊息（ID 或連結）往前讀"}, "around": {"type": "string", "description": "讀這則訊息（ID 或連結）前後的訊息"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50, "description": "最多幾則，預設 20"}}, "additionalProperties": false}}, {"type": "function", "name": "search_messages", "description": "用 Discord 內建搜尋找目前頻道裡含有關鍵字的訊息，結果由新到舊，每次最多 25 筆，用回傳的 next_offset 取得下一頁。剛發出的訊息可能還搜尋不到。搜尋失敗時改用 read_messages 往回讀。", "inputSchema": {"type": "object", "properties": {"content": {"type": "string", "description": "要搜尋的關鍵字"}, "offset": {"type": "integer", "minimum": 0, "maximum": 9975, "description": "略過前面幾筆，預設 0"}}, "required": ["content"], "additionalProperties": false}}, {"type": "function", "name": "view_message_images", "description": "查看目前頻道某則訊息附帶的圖片。圖片會接在「〔工具附上的圖片〕」之後送進對話讓你直接看。一次最多 4 張。", "inputSchema": {"type": "object", "properties": {"message": {"type": "string", "description": "訊息 ID 或連結"}}, "required": ["message"], "additionalProperties": false}}]}]}}}
