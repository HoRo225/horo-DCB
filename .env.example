# Required: create the Discord application and Bot token first.
DISCORD_TOKEN=[REDACTED_SECRET]

# Required after the first 9Router login and provider setup.
NINEROUTER_API_KEY=[REDACTED_SECRET]
NINEROUTER_MODEL=horo-main
NINEROUTER_WEB_SEARCH_PROVIDER=tavily
NINEROUTER_WEB_FETCH_PROVIDER=tavily

# Semantic Memory is opt-in for fresh clones because it stores guild text locally
# and creates embedding requests. Existing deployments keep their previous default
# unless they add this variable explicitly.
SEMANTIC_MEMORY_ENABLED=0
NINEROUTER_EMBEDDING_MODEL=gemini/gemini-embedding-2
NINEROUTER_EMBEDDING_DIMENSIONS=768

# These features create or manage Discord channels. Fresh clones require opt-in.
TEMP_VOICE_ENABLED=0
STEAM_FREE_GAMES_ENABLED=0

# Discord Components V2 text rendering. Set to 0 for native message text.
AI_TEXT_DISPLAY_ENABLED=1

# Generated locally by scripts/setup.sh. Do not reuse these values elsewhere.
JWT_SECRET=[REDACTED_SECRET]
INITIAL_PASSWORD=[REDACTED_SECRET]
API_KEY_SECRET=[REDACTED_SECRET]
MACHINE_ID_SALT=[REDACTED_SECRET]
