# Required: create the Discord application and Bot token first.
DISCORD_TOKEN=[REDACTED_SECRET]

# Set the Guild here, then select 1-25 text channels and roles from /控制台.
# Channel and User IDs are optional legacy seeds kept for upgrade/rollback only.
CODEX_ENABLED=0
CODEX_ALLOWED_GUILD_ID=
CODEX_ALLOWED_CHANNEL_ID=
CODEX_ALLOWED_USER_IDS=
CODEX_BRIDGE_TOKEN=[REDACTED_SECRET]

# These features create or manage Discord channels. Fresh clones require opt-in.
TEMP_VOICE_ENABLED=0
STEAM_FREE_GAMES_ENABLED=0

# Server Activity is opt-in because it persistently stores Guild activity metadata.
SERVER_ACTIVITY_ENABLED=0

# Discord Components V2 text rendering. Set to 0 for native message text.
AI_TEXT_DISPLAY_ENABLED=1
